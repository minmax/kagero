{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@kagero/core": ["packages/core/src/index.ts"],
      "@kagero/pi-backend": ["packages/pi-backend/src/index.ts"],
      "@kagero/cli-backend": ["packages/cli-backend/src/index.ts"],
      "@kagero/mcp": ["packages/mcp/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "packages/*/dist"]
}
